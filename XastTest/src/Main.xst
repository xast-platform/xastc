fn computePosition(Pos, Velocity) -> Pos;

fn computePosition (Pos px py) (Velocity vx vy) = 
    Pos (px + vx) (py + vy);

fn computePosition pos (Velocity vx vy) =
    Pos {
        x = pos.x + vx,
        y = pos.y + vy
    };

