module Test exports *

extern type Int;
extern type Byte;
extern type Long;
extern fn opAdd(a, a) -> a;
extern fn opNeg(a) -> a;

fn x() -> Byte;
fn x = -129b;

@Mode(Strict)
system Increment #(Long) -> Long;
system Increment other = other + 1L;

@Mode(Strict)
system Clamp0To100 #(Int) -> Int;
system Clamp0To100 100   = 0;
system Clamp0To100 other = other + 1;